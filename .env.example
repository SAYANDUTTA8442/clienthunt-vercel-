# Copy to .env.local (your machine; wins) or .env (fallback). NEVER commit either. Real deployments use Vercel environment variables.
# Precedence: variables already exported in the shell / injected by Vercel  >  .env.local  >  .env.
# Check your setup (prints names and verdicts only, never values):  npm run check-env

# Firebase service-account JSON on ONE line, wrapped in SINGLE quotes (double quotes break the \n in private_key).
# Or the Base64 form instead (no quotes needed):  base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"}'
# Firebase console > Project settings > General > Web API key (used only to verify admin passwords)
FIREBASE_WEB_API_KEY=
# Long random string (32+ chars); salts the hashed IPs and emails stored in rate-limit documents
RATE_SALT=
# Only needed if a frontend is hosted on a DIFFERENT origin than this Vercel project (comma-separated)
ALLOWED_ORIGINS=

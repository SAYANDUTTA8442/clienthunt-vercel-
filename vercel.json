{
  "cleanUrls": false,
  "regions": ["bom1"],
  "functions": { "api/index.js": { "maxDuration": 30 } },
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/register", "destination": "/clienthunt/register", "permanent": false },
    { "source": "/search-team", "destination": "/clienthunt/search-team", "permanent": false }
  ],
  "rewrites": [
    { "source": "/clienthunt", "destination": "/clienthunt.html" },
    { "source": "/clienthunt/", "destination": "/clienthunt.html" },
    { "source": "/clienthunt/register", "destination": "/clienthunt-register.html" },
    { "source": "/clienthunt/register/", "destination": "/clienthunt-register.html" },
    { "source": "/clienthunt/search-team", "destination": "/search-team.html" },
    { "source": "/clienthunt/search-team/", "destination": "/search-team.html" },
    { "source": "/clienthunt/rulebook", "destination": "/assets/rulebook.pdf" },
    { "source": "/clienthunt/rulebook/", "destination": "/assets/rulebook.pdf" },
    { "source": "/join", "destination": "/join.html" },
    { "source": "/join/", "destination": "/join.html" },
    { "source": "/collaborate", "destination": "/collaborate.html" },
    { "source": "/collaborate/", "destination": "/collaborate.html" },
    { "source": "/sponsor", "destination": "/sponsor.html" },
    { "source": "/sponsor/", "destination": "/sponsor.html" },
    { "source": "/admin/dashboard", "destination": "/admin/dashboard.html" },
    { "source": "/admin/dashboard/", "destination": "/admin/dashboard.html" },
    { "source": "/super/ultra/admin/evaluation/pre/submission", "destination": "/super/ultra/admin/evaluation/pre/submission/index.html" },
    { "source": "/super/ultra/admin/evaluation/pre/submission/", "destination": "/super/ultra/admin/evaluation/pre/submission/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://script.google.com https://script.googleusercontent.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
      ]
    },
    { "source": "/assets/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] },
    { "source": "/api", "headers": [ { "key": "Cache-Control", "value": "no-store" } ] },
    { "source": "/admin/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }, { "key": "Referrer-Policy", "value": "no-referrer" } ] },
    { "source": "/super/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }, { "key": "Referrer-Policy", "value": "no-referrer" } ] }
  ]
}
